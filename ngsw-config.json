{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2|lottie)"]
      }
    },
    {
      "name": "game-data",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/data/**/*.json",
          "/assets/data/**/*.ts",
          "/assets/i18n/**/*.json"
        ]
      }
    },
    {
      "name": "kanji-compose-audio",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/audio/kanji-compose/**/*.m4a",
          "/audio/kanji-compose/*.m4a"
        ]
      }
    },
    {
      "name": "hanzi-numbers-audio",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/audio/hanzi-numbers/**/*.m4a",
          "/audio/hanzi-numbers/*.m4a"
        ]
      }
    },
    {
      "name": "game-audio",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/audio/**/*.wav",
          "/audio/*.wav"
        ]
      }
    },
    {
      "name": "game-animations",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/lottie/*.lottie"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-sync",
      "urls": ["/api/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "1d",
        "timeout": "10s"
      }
    }
  ]
}